---
import ProductCard from './ProductCard.astro';
---

<section id="proizvodi" class="py-16 md:py-24 bg-gradient-to-b from-white via-lightIce/20 to-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-deepBlue mb-4">
        Наши производи
      </h2>
      <p class="text-xl md:text-2xl text-deepBlue/80 max-w-3xl mx-auto">
        Све што производимо, производимо са поносом
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      <ProductCard
        title="Кајмак"
        description="Прави домаћи кајмак, зрео и пуног укуса. Припремљен на традиционалан начин – скидамо павлаку са свежег млека и остављамо да сазри у дрвеним посудама. Незаобилазан уз роштиљ, топао хлеб или домаћу пљескавицу."
        placeholderLabel="Фотографија кајмака"
      />

      <ProductCard
        title="Млади кајмак"
        description="Направљен по традиционалној рецептури у месту где се прави најбољи кајмак у Србији. Вековна традиција доброг укуса. Производ на који смо највише поносни."
        ingredients="млеко и со"
        image="images/products/mladi_kajmak.webp"
        placeholderLabel="Фотографија младог кајмака"
      />

      <ProductCard
        title="Млади сир"
        description="За све љубитеље здраве исхране. Наш млади сир направљен је по традиционалној рецептури од наших бака у контролисаним условима. Можемо га правити као слан или неслан."
        ingredients="млеко, сирило и со"
        image="images/products/mladi_sir.webp"
        placeholderLabel="Фотографија младог сира"
      />

      <ProductCard
        title="Зрели сир"
        description="Препознатљиво доброг укуса. Заштићеног географског порекла. Произведен по највишим стандардима, без додатака. Препорука за конзумирање уз вино и домаћу пршуту. Сир који помера границе доброг укуса."
        ingredients="млеко, сирило и со"
        image="images/products/zreli_sir.webp"
        placeholderLabel="Фотографија зрелог сира"
      />

      <ProductCard
        title="Ситан сир (намаз)"
        description="Сир који је аутентичан производ Мале млекаре Јанић. Направљен по јединственој рецептури. Направљен да промени мишљење о ситном сиру. Најсличнији укусу са намазом. Погодан за мазање, прављење салата попут сусам салате, као и за филовање пита и гибаница."
        image="images/products/sitan_sir_namaz.webp"
        placeholderLabel="Фотографија ситног сира"
      />
    </div>
  </div>
</section>
